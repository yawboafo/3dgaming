    "three": "0.186.1",
    "three-pathfinding": "1.3.0",
    "yuka": "0.7.8"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.8",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
